{
  "backend": "fs",
  "leaseTtlSeconds": 2700,
  "renewIntervalSeconds": 300,
  "gated": true,
  "idRegisters": {},
  "guardedFiles": [
    "docs/evidence/backlog.md",
    "docs/evidence/verification.md",
    "docs/evidence/retro.md",
    "skills.json",
    "README.md",
    "pipeline.json",
    "skills/*/CHANGELOG.md",
    "skills/*/package.json",
    "skills/*/.claude-plugin/marketplace.json",
    "skills/*/plugins/*/.claude-plugin/plugin.json",
    "skills/*/docs/evidence/backlog.md",
    "skills/*/docs/evidence/verification.md",
    "skills/*/docs/evidence/retro.md",
    "skills/*/.github/workflows/*.yml",
    "skills/*/test/validate.py",
    "skills/*/test/negatives.py"
  ],
  "claimTags": {
    "docs/evidence/backlog.md": {
      "mode": "cell",
      "cell": -1,
      "held": "{prev} (claimed: {holder})"
    }
  },
  "gates": [],
  "mirror": {
    "enabled": false,
    "sources": []
  },
  "mergeLog": {
    "file": "docs/MERGES.md",
    "retentionDays": 7
  }
}
