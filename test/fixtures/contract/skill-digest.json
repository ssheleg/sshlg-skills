{
  "description": "skill-digest/1 (DEC-0204, DEC-0206): the digest of a skill or plugin root, by the hub's route (its pinned entries) and the node's (the installed folder). Written by tools/vectors/skill-digest.ts; never edit by hand.",
  "algorithm": "sha256: + hex SHA-256 of the UTF-8 RFC 8785 form of {files: [{path, sha256}]}; paths relative, '/', NFC, ordered by UTF-8 bytes; sha256 in the sha256: form; .git and __pycache__ segments and .DS_Store files excluded, and in a plugin's root the .in_use folder and the .orphaned_at file; a link to a file counts as its target's bytes, a dangling link or a link to a directory leaves the digest unknown",
  "cases": [
    {
      "name": "a skill of one file",
      "kind": "skill",
      "route": "both",
      "files": [
        {
          "path": "SKILL.md",
          "text": "---\nname: demo\ndescription: A demo skill.\n---\n\n# Demo\n"
        }
      ],
      "expected": {
        "digest": "sha256:a612d4e855bb6c821b69f544125825f29f6385b74520fa5fd185cbbe57b052f7",
        "canonical": "{\"files\":[{\"path\":\"SKILL.md\",\"sha256\":\"sha256:cb96c3017fd9c69e7a91d450aeb1dc167b18fa7f2bd96387a9d3cf9769643969\"}]}"
      }
    },
    {
      "name": "a skill with a nested reference",
      "kind": "skill",
      "route": "both",
      "files": [
        {
          "path": "SKILL.md",
          "text": "---\nname: demo\ndescription: A demo skill.\n---\n\n# Demo\n"
        },
        {
          "path": "references/notes.md",
          "text": "notes\n"
        }
      ],
      "expected": {
        "digest": "sha256:53e666f30d80021b402d0a6e0a5561bd506202781c93266edb5c23b4df2cab5a",
        "canonical": "{\"files\":[{\"path\":\"SKILL.md\",\"sha256\":\"sha256:cb96c3017fd9c69e7a91d450aeb1dc167b18fa7f2bd96387a9d3cf9769643969\"},{\"path\":\"references/notes.md\",\"sha256\":\"sha256:444e0fffbd825e9610ff5b199485707a0c895339ae80c15cc8a8aee41b106fda\"}]}"
      }
    },
